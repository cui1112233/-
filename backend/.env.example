QIANTIE_ADDR=127.0.0.1:4000
QIANTIE_MYSQL_DSN=qiantie:qiantie@tcp(127.0.0.1:3306)/qiantie?parseTime=true&charset=utf8mb4&loc=Local
QIANTIE_SEED_USERNAME=choushiyiguai
QIANTIE_SEED_PASSWORD=123456
QIANTIE_TOKEN_SECRET=dev-token-secret-change-me
# Must match the Node server QIANTIE_BRIDGE_SECRET. Use a long random value outside local development.
QIANTIE_BRIDGE_SECRET=dev-bridge-secret-change-me
QIANTIE_LEGACY_DATA_DIR=../data/users
QIANTIE_STORAGE_DRIVER=local
QIANTIE_STORAGE_LOCAL_DIR=../data/shuihuo-objects
QIANTIE_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:4000
# Redis endpoint is server-only and is never returned by the health API.
QIANTIE_REDIS_ADDR=127.0.0.1:6379
# Server-only credential map. Use references and redacted sample values only.
QIANTIE_MODEL_CREDENTIALS=TEXT_CREDENTIAL=REDACTED,VOLCENGINE_ACCESS_KEY_ID=REDACTED,VOLCENGINE_SECRET_ACCESS_KEY=REDACTED,VIDU_CREDENTIAL=REDACTED
# Server-only text provider endpoints keyed by credential reference; use HTTPS only.
QIANTIE_MODEL_ENDPOINTS=TEXT_CREDENTIAL=https://text-provider.example.com/v1/completions
# Server-only Volcengine credentials for the fixed Jimeng image adapter.
VOLCENGINE_ACCESS_KEY_ID=REDACTED
VOLCENGINE_SECRET_ACCESS_KEY=REDACTED
# Server-only Vidu endpoint and credential reference. Both must use HTTPS.
VIDU_API_BASE_URL=https://vidu-provider.example.com
VIDU_CREDENTIAL=REDACTED
# Required when QIANTIE_STORAGE_DRIVER is tos or minio.
QIANTIE_STORAGE_BUCKET=
QIANTIE_STORAGE_ENDPOINT=
QIANTIE_STORAGE_REGION=
QIANTIE_STORAGE_ACCESS_KEY=
QIANTIE_STORAGE_SECRET_KEY=
