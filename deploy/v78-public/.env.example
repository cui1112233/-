# Copy this file to deploy/v78-public/.env on the server.
# Never commit the real .env file.

PUBLIC_IP=115.190.156.223
PUBLIC_PORT=3000

MYSQL_DATABASE=qiantie
MYSQL_USER=qiantie
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# Node <-> Go signed internal bridge. Use the same value in both services.
QIANTIE_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM_BRIDGE_SECRET

# Node <-> 121 Browser Worker internal secret.
QIANTIE_121_WORKER_SECRET=CHANGE_ME_LONG_RANDOM_WORKER_SECRET

# Encrypts saved 121 credentials on disk. Keep stable after first deployment.
QIANTIE_121_CREDENTIAL_SECRET=CHANGE_ME_LONG_RANDOM_CREDENTIAL_SECRET

# Absolute path of the second checkout containing backend/Dockerfile.
# The checkout must resolve to the exact verified Go bridge SHA below.
# Offline ECS deployment does not build from this path, but Compose still receives it.
QIANTIE_GO_SOURCE_DIR=/opt/qiantie/go
QIANTIE_GO_EXPECTED_SHA=13e40da4092046846ad13c5c0bbb15918216465a

# Current Go feature gate. Slice 1 keeps the existing V11 Go settings/intake APIs available.
QIANTIE_BATCH_FACTORY_V11_SLICE=1

# Release snapshots and backups stay outside active Docker volumes.
QIANTIE_RELEASE_ROOT=/opt/qiantie/releases
QIANTIE_BACKUP_ROOT=/opt/qiantie/backups

# Server-only file used to encrypt the .env copy inside backups.
# Create once on ECS:
#   umask 077
#   openssl rand -hex 32 > /root/.qiantie-backup-passphrase
#   chmod 600 /root/.qiantie-backup-passphrase
QIANTIE_BACKUP_PASSPHRASE_FILE=/root/.qiantie-backup-passphrase
