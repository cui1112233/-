# Docker image used by both runtime containers. Set this to a trusted mirror only
# when Docker Hub is unavailable on the local machine.
NODE_IMAGE=node:24-alpine

# Apple Silicon uses arm64. Change to amd64 on an Intel Docker host.
QIANTIE_ARCH=arm64
QIANTIE_PLATFORM_PORT=3000
QIANTIE_BACKEND_PORT=14000

# Test-only secrets. The deploy script creates unique values in .env.test-docker.
MYSQL_PASSWORD=replace-with-a-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-random-value
QIANTIE_TOKEN_SECRET=replace-with-a-random-value
QIANTIE_BRIDGE_SECRET=replace-with-a-random-value
QIANTIE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

QIANTIE_SEED_USERNAME=choushiyiguai
QIANTIE_SEED_PASSWORD=123456

# Keep provider credentials outside source control. Leave blank to start the UI
# and platform APIs without enabling paid provider requests.
QIANTIE_MODEL_CREDENTIALS=
QIANTIE_MODEL_ENDPOINTS=
