# Copy to /opt/qiantie/v88/deploy/v88-public/merge.env on ECS.
# Never commit real values. The public deploy workflow refuses to continue
# when any required value below is missing or empty.

# Go API capability gate. Keep Slice below 5 until worker health is verified.
QIANTIE_BATCH_FACTORY_V11_SLICE=3
QIANTIE_BATCH_FACTORY_V11_MERGE_ENABLED=0
QIANTIE_BATCH_FACTORY_V11_MERGE_API_KEY=replace-with-same-value-as-worker-secret

# Internal worker authentication.
QIANTIE_MERGE_WORKER_SECRET=replace-with-long-random-secret

# Dedicated Merge Redis. This password is consumed by merge-redis only.
QIANTIE_MERGE_REDIS_PASSWORD=replace-with-long-random-password
QIANTIE_MERGE_REDIS_URL=redis://:replace-with-url-escaped-password@merge-redis:6379/0

# Volcengine TOS destination for final merged MP4 files.
QIANTIE_MERGE_TOS_ENDPOINT=replace-with-tos-endpoint
QIANTIE_MERGE_TOS_REGION=replace-with-tos-region
QIANTIE_MERGE_TOS_BUCKET=replace-with-bucket
QIANTIE_MERGE_TOS_ACCESS_KEY=replace-with-access-key
QIANTIE_MERGE_TOS_SECRET_KEY=replace-with-secret-key
QIANTIE_MERGE_TOS_PUBLIC_BASE_URL=https://replace-with-public-or-cdn-base
