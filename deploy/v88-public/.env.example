# Use immutable image tags or digests created from one Git commit.
QIANTIE_RELEASE_SHA=replace-with-40-char-git-sha
QIANTIE_NODE_IMAGE=registry.example/qiantie-v88-node:replace-with-git-sha
QIANTIE_GO_IMAGE=registry.example/qiantie-go-api:replace-with-git-sha
QIANTIE_SHUIHUO_COMPAT_IMAGE=qiantie-go-api:public-v78
QIANTIE_BROWSER_WORKER_IMAGE=qiantie-121-browser-worker:public-v88

# Existing qiantie-unified-mysql connection values. Replace before deployment.
MYSQL_DATABASE=qiantie_v88
MYSQL_USER=replace-me
MYSQL_PASSWORD=replace-me

# Required runtime secret names. Supply values in the ECS-only .env file.
QIANTIE_BRIDGE_SECRET=replace-me
QIANTIE_121_WORKER_SECRET=replace-me
QIANTIE_121_CREDENTIAL_SECRET=replace-me
