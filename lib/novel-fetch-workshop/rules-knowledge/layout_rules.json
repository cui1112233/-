{
  "source": "TextLayoutToolAI",
  "indent_spaces": 0,
  "blank_lines_before": 0,
  "delimiters": [
    "？】",
    "。】",
    "。”",
    "！”",
    "？”",
    "。」",
    "。",
    "？"
  ],
  "drop_empty_lines": true,
  "line_len_min": "15",
  "line_len_max": "16",
  "enable_len_wrap": true,
  "target_line_len": 15,
  "apply_sensitive_replace": true
}
