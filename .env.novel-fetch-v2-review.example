# Copy to a temporary local env file outside production paths before review.
# Never commit real values.
QIANTIE_REVIEW_HOST_PORT=13107
QIANTIE_REVIEW_DATA_DIR=./.tmp/novel-fetch-v2-review/platform-data
QIANTIE_REVIEW_WORKER_DATA_DIR=./.tmp/novel-fetch-v2-review/worker-data

QIANTIE_PLATFORM_REVIEW_IMAGE=qiantie-platform:review-v2-local
QIANTIE_121_WORKER_REVIEW_IMAGE=qiantie-121-browser-worker:review-v2-local

# Generate independent high-entropy values for every review run.
QIANTIE_121_WORKER_SECRET=
QIANTIE_121_CREDENTIAL_SECRET=
QIANTIE_121_STORAGE_STATE_SECRET=
