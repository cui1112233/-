# V88 隔离候选环境示例。只使用临时目录和测试密钥，禁止指向生产。
QIANTIE_V88_HOST_PORT=13188
QIANTIE_V88_PUBLIC_BASE_URL=http://127.0.0.1:13188
QIANTIE_V88_DATA_DIR=/tmp/qiantie-v88-review/platform-data
QIANTIE_V88_MYSQL_DATA_DIR=/tmp/qiantie-v88-review/mysql-data
QIANTIE_V88_WORKER_DATA_DIR=/tmp/qiantie-v88-review/worker-data
QIANTIE_V88_ARTIFACT_DATA_DIR=/tmp/qiantie-v88-review/artifact-data
QIANTIE_V88_REDIS_DATA_DIR=/tmp/qiantie-v88-review/redis-data

QIANTIE_V88_PLATFORM_IMAGE=qiantie-platform:v88-review-local
QIANTIE_V88_BACKEND_IMAGE=qiantie-backend:v88-review-local
QIANTIE_V88_WORKER_IMAGE=qiantie-121-browser-worker:v88-review-local
QIANTIE_V88_MERGE_WORKER_IMAGE=qiantie-merge-worker:v88-review-local

# Backend refuses to start unless these are explicitly supplied.
QIANTIE_V88_MYSQL_PASSWORD=
QIANTIE_V88_MYSQL_ROOT_PASSWORD=
QIANTIE_V88_BRIDGE_SECRET=
QIANTIE_V88_TEXT_ENDPOINT=
QIANTIE_V88_TEXT_API_KEY=
QIANTIE_V88_TEXT_MODEL=

# Default slice 4 enables personal-center video API + local executor.
# Keep merge disabled unless the `merge` Compose profile is running and healthy.
QIANTIE_V88_SLICE=4
QIANTIE_V88_PRODUCTION_ENABLED=1
QIANTIE_V88_MERGE_ENABLED=0
QIANTIE_V88_MERGE_ENDPOINT=http://merge-worker:8790/v1/merge
QIANTIE_V88_MERGE_POLL_ENDPOINT=http://merge-worker:8790/v1/merge/{id}
QIANTIE_V88_MERGE_API_KEY=

# First-party BF11 merge worker. Required only when using --profile merge.
# QIANTIE_V88_MERGE_API_KEY and QIANTIE_V88_MERGE_WORKER_SECRET must contain the same runtime secret.
QIANTIE_V88_MERGE_WORKER_SECRET=
QIANTIE_V88_REDIS_PASSWORD=
QIANTIE_V88_MERGE_TOS_ENDPOINT=
QIANTIE_V88_MERGE_TOS_REGION=
QIANTIE_V88_MERGE_TOS_BUCKET=
QIANTIE_V88_MERGE_TOS_ACCESS_KEY=
QIANTIE_V88_MERGE_TOS_SECRET_KEY=
QIANTIE_V88_MERGE_TOS_PUBLIC_BASE_URL=

QIANTIE_V88_121_ENABLED=0
QIANTIE_V88_121_ENDPOINT=
QIANTIE_V88_121_API_KEY=
QIANTIE_V88_YADI_ENABLED=0
QIANTIE_V88_YADI_ENDPOINT=
QIANTIE_V88_YADI_API_KEY=
QIANTIE_V88_EXTERNAL_CREDENTIALS_KEY=

QIANTIE_V88_121_WORKER_SECRET=
QIANTIE_V88_121_CREDENTIAL_SECRET=
QIANTIE_V88_121_STORAGE_STATE_SECRET=
